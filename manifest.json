{
  "manifest_version": 3,
  "name": "Lot Linker Fill",
  "version": "2.2.0",
  "description": "Fill Marketplace vehicle Model + description + photos from stock. You hit Post.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lot Linker Fill",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://facebook.com/*",
    "https://www.facebook.com/*",
    "https://raw.githubusercontent.com/*",
    "https://www.nissanlakecountry.com/*",
    "https://www.hyundailakecountry.com/*",
    "https://*.boucher.com/*",
    "https://vpic.nhtsa.dot.gov/*",
    "https://vehicle-images.carscommerce.inc/*",
    "https://*.carscommerce.inc/*",
    "https://pictures.dealer.com/*",
    "https://images.dealer.com/*",
    "https://imagescdn.dealercarsearch.com/*",
    "https://*.cloudfront.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": [
        "listing-copy.js",
        "photos.js",
        "content-fb.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "packs.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
