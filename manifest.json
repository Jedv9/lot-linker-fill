{
  "manifest_version": 3,
  "name": "Lot Linker Fill",
  "version": "2.0.0",
  "description": "Fill Marketplace title + description from stock. Boucher Lake Country. You hit Post.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lot Linker Fill",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://facebook.com/*",
    "https://www.facebook.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": [
        "listing-copy.js",
        "content-fb.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "packs.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
